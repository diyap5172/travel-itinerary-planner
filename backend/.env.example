# Copy this file to ".env" and fill the values.
# 1) AI (Google Gemini). Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Set true to use built-in sample itineraries (no API key needed)
MOCK_AI=true

# 2) Supabase (optional). If empty, trips are saved in backend/data/trips.json
SUPABASE_URL=
SUPABASE_KEY=

# 3) Frontend URL allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
